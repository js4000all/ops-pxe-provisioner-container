# Port exposed on the Windows/Linux host for ISO and other static assets.
HTTP_PORT=8080

# Kernel arguments depend on the installer image.
# Replace the example with parameters appropriate for your distribution.
# Example for Ubuntu live-server (adjust ISO filename and Windows host LAN IP):
# KERNEL_CMDLINE=ip=dhcp url=http://192.168.1.10:8080/iso/ubuntu-live-server.iso
KERNEL_CMDLINE=ip=dhcp
