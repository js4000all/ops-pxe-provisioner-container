HTTP_PORT=8080

# Select an official Ubuntu Server live ISO (replace version as needed).
ISO_URL=https://releases.ubuntu.com/24.04/ubuntu-24.04.3-live-server-amd64.iso
# Optional: pin SHA256. If empty, SHA256SUMS is downloaded from ISO_URL's directory over HTTPS.
ISO_SHA256=

# Replace the host LAN address with an address reachable from PXE clients.
KERNEL_CMDLINE=ip=dhcp url=http://192.168.1.10:8080/iso/ubuntu-live-server.iso
